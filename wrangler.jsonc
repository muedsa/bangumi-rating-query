{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bangumi-rating-query",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "upload_source_maps": true,
  "vars": {
    "BANGUMI_USER_AGENT": "muedsa/bangumi-rating-query (https://github.com/muedsa/bangumi-rating-query)",
    "STATS_ENABLED": "false",
    "ALIAS_MISS_STATS_ENABLED": "true",
    "MAX_BATCH_SIZE": "20",
    "RATING_TTL_HOURS": "24",
    "CALENDAR_SYNC_ENABLED": "true",
    "CALENDAR_SYNC_HOUR_UTC": "20",
    "CALENDAR_PLATFORM_BATCH_SIZE": "1000",
  },
  "triggers": {
    // 仅 calendar 使用内置定时任务；修改小时配置时需同步修改这里的 UTC Cron。
    "crons": ["0 20 * * *"],
  },
  // ADMIN_TOKEN 和 BANGUMI_ACCESS_TOKEN 通过 wrangler secret put 配置，禁止在 vars 中填写。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bangumi-rating-query",
      "database_id": "1d3f8551-7394-49bc-99bc-06c558c88a9f",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
}
