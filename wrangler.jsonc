{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bangumi-rating-query",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-10-20",
  // @cloudflare/puppeteer 的 ESM 构建使用 node:buffer；Browser Rendering 由下方 browser 绑定提供。
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER",
  },
  "workers_dev": true,
  "upload_source_maps": true,
  "vars": {
    "BANGUMI_USER_AGENT": "muedsa/bangumi-rating-query (https://github.com/muedsa/bangumi-rating-query)",
    "STATS_ENABLED": "false",
    "ALIAS_MISS_STATS_ENABLED": "true",
    "MAX_BATCH_SIZE": "20",
    "RATING_TTL_HOURS": "24",
    "CALENDAR_SYNC_ENABLED": "true",
    "CALENDAR_SYNC_HOUR_UTC": "20",
    "CALENDAR_PLATFORM_BATCH_SIZE": "1000",
    "TRENDS_SYNC_ENABLED": "true",
    "TRENDS_SYNC_HOUR_UTC": "21",
    "TRENDS_SYNC_LIMIT": "24",
    "TRENDS_FETCH_MODE": "browser",
    "TRENDS_BROWSER_TIMEOUT_MS": "45000",
  },
  "triggers": {
    // 修改小时配置时需同步修改这里的 UTC Cron；两个任务各自匹配对应的表达式。
    "crons": ["0 20 * * *", "0 21 * * *"],
  },
  // ADMIN_TOKEN 和 BANGUMI_ACCESS_TOKEN 通过 wrangler secret put 配置，禁止在 vars 中填写。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bangumi-rating-query",
      "database_id": "1d3f8551-7394-49bc-99bc-06c558c88a9f",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
}
