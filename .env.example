HOST=0.0.0.0
PORT=3000
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/bangumi.sqlite
# PostgreSQL：将 DATABASE_DRIVER 改为 postgres，并设置连接串。勿提交真实密码。
# DATABASE_URL=postgresql://bangumi:password@127.0.0.1:5432/bangumi
# 每个 Node/CLI 进程的连接池上限，默认 10（范围 1~100），仅 PostgreSQL 使用。
DATABASE_POOL_SIZE=10
# 留空时关闭管理 API；生产环境使用至少 32 字符的随机值。
ADMIN_TOKEN=
# 关闭时，查询不会读写访问统计。
STATS_ENABLED=false
# 独立记录未知查询名称及累计未命中次数，默认关闭。
ALIAS_MISS_STATS_ENABLED=false
MAX_BATCH_SIZE=20
RATING_TTL_HOURS=24
# Node 服务端或本地同步 CLI 访问 Bangumi 时使用的应用标识。
BANGUMI_USER_AGENT=
# 可选；填写原始 Access Token（不含 Bearer 前缀）。线上 Worker 使用同名 Secret。
BANGUMI_ACCESS_TOKEN=
# Node 每日定时导入日历；20:00 UTC 对应北京时间次日 04:00。
CALENDAR_SYNC_ENABLED=false
CALENDAR_SYNC_HOUR_UTC=20
# 每次同步补全的作品形式数量，默认 10，允许设置更大的正整数。
CALENDAR_PLATFORM_BATCH_SIZE=10
# Node 每日抓取 trends 第 1 页；21:00 UTC 对应北京时间次日 05:00。
TRENDS_SYNC_ENABLED=false
TRENDS_SYNC_HOUR_UTC=21
# 仅取首页热度靠前的条目，默认最多 24 条，允许 1～100；不翻页。
TRENDS_SYNC_LIMIT=24
# browser 使用 Puppeteer 启动浏览器完成 Cloudflare 验证；http 直接请求页面，可能被 403 拒绝。
TRENDS_FETCH_MODE=browser
# 等待页面通过验证并出现热度列表的最长时间，5000～120000 毫秒。
TRENDS_BROWSER_TIMEOUT_MS=45000
# Node 可选：Chrome/Chromium 可执行文件路径；留空时使用 Puppeteer 自带的 Chrome。
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Node 可选：复用浏览器用户目录和 cf_clearance Cookie；Docker 默认写入数据卷。
# PUPPETEER_USER_DATA_DIR=./data/browser-profile
# Node 可选：有显示环境时设为 false，可用有头浏览器处理交互式验证。
# PUPPETEER_HEADLESS=false
# 远程同步、备份：CLI 追加 --api-url https://你的服务地址，复用 ADMIN_TOKEN。
